{
  "opencollection": "1.0.0",
  "info": {
    "name": "Microcks API v1.14 config mock API",
    "version": "1.14.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://keycloak.example.com/realms/microcks/protocol/openid-connect/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
